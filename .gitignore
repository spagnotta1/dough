# Secrets
# The wildcard covers .env.local, .env.production and whatever the next one is
# called -- a variant nobody thought to add here is exactly the one that gets
# committed. .env.example is the documented template and is re-admitted below;
# it must stay free of real values, which tests/test_secret_hygiene.py checks.
.env
.env.*
!.env.example
.sync_encryption_key
.dev-cert.pem
.dev-key.pem
.flask_secret_key

# Databases
*.db
*.db.pre-sync-backup
backups/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Playwright writes screenshots, videos and traces here when a browser test
# fails. Useful locally, never worth committing.
test-results/

# Node
node_modules/
.expo/

# Uploads / local data
uploads/

# Separate embedded project (own git repo)
quick-test/

# Editors / OS
.claude/
.DS_Store

# Category rules were stored here -- one file at the repo root, shared by every
# household in the installation, and committed, so every deployment image
# shipped the developer's personal rules to every account on it. See SEC-0025.
#
# They live in the tenant-scoped `category_rules` table now
# (migrations/20260802_08_category_rules). The file is kept out of git so it can
# never be shipped again; it is still read once, by that migration, to backfill
# an existing installation, so a local copy is harmless and a tracked one is not.
category_rules.json
