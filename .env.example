# Dough — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#   cp .env.example .env
#
# Every value here is optional in development: the app generates a session key
# and an encryption key, falls back to sandbox data when Plaid is unconfigured,
# and degrades the AI features to a clean 503 when the Anthropic key is absent.
#
# ─── What production actually requires ──────────────────────────────────────
#
# `APP_ENV=production` refuses to start without these two, and reports *every*
# missing one at once rather than one per restart (config.py, REQUIRED_SECRETS):
#
#   SECRET_KEY       signs the session cookie and the CSRF token
#   ENCRYPTION_KEY   decrypts the stored bank/brokerage access tokens
#
# These three are optional everywhere; without them one capability is off and
# the rest of the application is unaffected:
#
#   ANTHROPIC_API_KEY              Dough, the AI assistant
#   PLAID_CLIENT_ID + PLAID_SECRET account synchronization (else: sandbox)
#   DATABASE_URL                   defaults to a local SQLite file
#
# PLAID_CLIENT_ID and the secret are both-or-neither: exactly one of them set is
# refused, because that is a deployment that authenticates against the live API
# and fails, believing itself configured.
#
# Nothing in this file is ever logged. `docs/security.md` ("Secrets") has the
# rotation procedure for each one.
# ────────────────────────────────────────────────────────────────────────────

# --- Core -------------------------------------------------------------------

# Signs the session cookie. If unset, a random key is generated once and
# persisted to `.flask_secret_key` next to the database.
# REQUIRED in production — a generated key would be replaced on every restart,
# invalidating every session.
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# `SESSION_SECRET` is accepted as an alias, for platforms that inject that name.
# SECRET_KEY wins if both are set.
SECRET_KEY=

# development | testing | production. Selects the config class.
APP_ENV=development

# --- Encryption at rest -----------------------------------------------------

# Fernet key protecting `connected_accounts.auth_blob` — the Plaid and Coinbase
# access tokens, which are the credentials that read your real bank data.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# If unset outside production, a key is generated once into
# `.sync_encryption_key` next to the database and read from there afterwards.
#
# REQUIRED in production, and it will refuse to start rather than generate one.
# Generating a key is silent, succeeds, and makes every already-stored token
# unreadable — and the failure does not arrive at boot, it arrives at the next
# sync. On a container filesystem that starts empty on each deploy, that is
# every connection breaking on every deploy with nothing saying why.
#
# BACK THIS UP. Lose it and every institution has to be linked again; leak it
# and the stored tokens read the accounts directly.
#
# `SYNC_ENCRYPTION_KEY` is the older name and still wins if both are set, so an
# existing installation needs no change.
ENCRYPTION_KEY=

# --- Dev server -------------------------------------------------------------
# Only read by `python app.py`. `flask --app app run` ignores these.

APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=1

# Serve over HTTPS with a self-signed localhost cert, and set the Secure flag on
# the session cookie. Plaid requires an HTTPS redirect URI even in sandbox.
APP_HTTPS=0

# --- Database ---------------------------------------------------------------

# Defaults to sqlite:///checkbook.db. A postgres:// URL is rewritten to
# postgresql+psycopg:// automatically.
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/dough
DATABASE_URL=

# --- AI (Anthropic) ---------------------------------------------------------

# Powers Dough: chat, dashboard insights, the investment brief, rule
# suggestions. Without it those endpoints return 503 and the rest of the app is
# unaffected.  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Seconds to cache generated insights. Default 3600.
AI_INSIGHT_CACHE_TTL=3600

# --- Plaid ------------------------------------------------------------------
# Leave PLAID_CLIENT_ID blank to run against the built-in deterministic sandbox
# (finance_sync/sandbox.py) with no network calls at all.

PLAID_CLIENT_ID=
PLAID_ENV=sandbox

# The secret matching PLAID_ENV is the one that gets used.
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=

# Must be registered in the Plaid dashboard and must be HTTPS.
PLAID_REDIRECT_URI_SANDBOX=https://localhost:5000/connections/callback/plaid
PLAID_REDIRECT_URI_PRODUCTION=

# --- Coinbase (optional) ----------------------------------------------------

COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=

# --- Background sync --------------------------------------------------------

# The scheduler starts once per *process*. Two workers means two schedulers
# syncing the same connections at the same time (OPS-0012 in docs/security.md).
# Safe with a single worker; leave this off until your process model is
# settled. Manual Refresh works either way.
SYNC_AUTO_ENABLED=0
SYNC_INTERVAL_HOURS=12

# --- Backups ----------------------------------------------------------------

# Verified snapshots of the database, taken by the serving process: one shortly
# after startup, then every BACKUP_INTERVAL_HOURS. Each is checked with
# PRAGMA integrity_check and a row count per table, and a snapshot that fails
# either is deleted rather than kept.
#
# Deliberately a separate switch from SYNC_AUTO_ENABLED above. That one is off
# by default because two schedulers call somebody's bank twice; this one is on
# by default because the failure it prevents is losing the data. They share a
# process-count constraint and nothing else.
#
# Snapshots land beside the database file unless BACKUP_DIR says otherwise --
# which in production means the mounted volume rather than the container image.
# See docs/deploy-railway.md.
BACKUP_AUTO_ENABLED=1
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
BACKUP_DIR=

# --- Authentication (Phase 6) -----------------------------------------------

# Whether strangers may create an account. Default off: this app fronts real
# bank data and is frequently exposed on a LAN.
ALLOW_REGISTRATION=0

# DECLARED BUT NOT YET ENFORCED. Setting it to 1 does nothing today.
#
# Verification itself works — /register sends a link, /verify-email/<token>
# redeems it, and the timestamp lands in app_users.email_verified_at — but
# nothing reads that column to gate anything, so no sign-in is refused.
#
# Left unwired deliberately rather than half-wired: gating sign-in on a mail
# round-trip is the one switch that can lock every existing account out at
# once, and it must not be flippable before an operator has confirmed their
# mail actually delivers. Wiring it is a one-line check in dough/auth.py when
# that is true.
REQUIRE_EMAIL_VERIFICATION=0

# Absolute base URL used to build links in emails, e.g. https://dough.example.com
PUBLIC_BASE_URL=

# --- Email (Phase 6) --------------------------------------------------------

# console | smtp. The console backend prints verification and reset links to
# the terminal, which is the intended default for a self-hosted instance.
#
# Leaving this at console on anything a second person can reach is a real gap
# rather than a cosmetic one: the links print into the process's stdout, so a
# registrant who forgets their password has no route back in and you cannot
# give them one without reading it out of the deploy log.
MAIL_BACKEND=console
MAIL_FROM=dough@localhost
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1

# MAIL_DEFAULT_SENDER is read as a second name for MAIL_FROM, and only because
# it is the name `flask_mail` uses and therefore the one every provider's setup
# page prints. This application does not use `flask_mail`. Prefer MAIL_FROM;
# set one or the other, not both.
MAIL_DEFAULT_SENDER=

# Postmark, which is what this installation runs on, looks like this:
#
#   MAIL_BACKEND=postmark
#   MAIL_PASSWORD=<server API token>
#   MAIL_FROM=no-reply@your-domain.example
#
# `postmark` sends over the HTTP API on 443 rather than over SMTP, and it is
# what this deployment uses because Railway blocks outbound SMTP -- 587 and
# 2525 alike, so there is no port to move to. Hosts that would otherwise make a
# convenient spam relay commonly do this. A blocked port does not announce
# itself: it looks like a send that takes exactly 30 seconds and then fails.
#
# One token is the whole credential. Postmark's SMTP endpoint takes the server
# API token as both username and password, and the HTTP API takes the same
# string as a header, so MAIL_PASSWORD carries it either way.
#
# MAIL_BACKEND=smtp still works wherever the ports are open; set MAIL_SERVER,
# MAIL_PORT, MAIL_USERNAME and MAIL_PASSWORD as above and point it at
# smtp.postmarkapp.com.
#
# MAIL_FROM must be a Sender Signature confirmed in the Postmark dashboard, or
# an address on a domain verified there. Postmark refuses any other From per
# message, which is a send-time failure rather than a startup one.
#
# A new Postmark account is also approved by hand, and until it is, every
# recipient must share the MAIL_FROM domain. Postmark accepts the SMTP session
# and turns the message into a bounce afterwards, so a send to an outside
# address looks like it worked and did not.

# --- Rate limiting (Phase 6) ------------------------------------------------

# memory | redis. In-memory state is per-process and resets on restart, which
# is correct for a single-process deployment and wrong for anything larger.
#
# As of Phase 10.6 this backend carries every declared policy, including the AI
# budget (60 model calls per household per hour, 300 per day) and the per-token
# API limits. Read that as a real ceiling with a known weakness rather than as a
# solved problem: a restart clears every counter, and a second worker doubles
# every allowance. `redis` is named and raises rather than falling back, because
# an operator who asks for a shared limiter and silently gets a per-process one
# has exactly the problem they were trying to avoid.
RATELIMIT_BACKEND=memory
REDIS_URL=
